# Copy to `.env` for local overrides. Never commit a real `.env`.
# Every value here is a local-development default; none of them is a secret.

# --- Event bus -------------------------------------------------------------
# `kafka` talks to Redpanda; `memory` is the in-process bus used by tests and `make dev`.
ALPHADOTS_BUS_BACKEND=kafka
ALPHADOTS_KAFKA_BOOTSTRAP=localhost:19092

# --- Storage ---------------------------------------------------------------
# Local compose credentials only. Production uses Secrets Manager references (M5).
ALPHADOTS_DATABASE_URL=postgresql+asyncpg://alphadots:alphadots-local-dev@localhost:15432/alphadots

# --- Fixtures --------------------------------------------------------------
ALPHADOTS_FIXTURES_DIR=data/fixtures

# --- Replay-mode availability modelling ------------------------------------
# Each stage adds this many seconds to `available_at`, so point-in-time filters never
# assume zero processing time. A modelling assumption, not a measurement.
ALPHADOTS_STAGE_LATENCY_ALLOWANCE_SECONDS=1.0

# --- Heuristic signal priors (NOT estimated; see docs/adr/0001) -------------
ALPHADOTS_SIGNAL_TAU_SECONDS=86400
ALPHADOTS_SIGNAL_LOOKBACK_SECONDS=432000

# --- API -------------------------------------------------------------------
# Leave empty for open local access. When set, every /v1 route requires
# `Authorization: Bearer <token>`. research_agent sends the same token when it calls
# the API, so set this (not a separate agent token) if you turn auth on.
ALPHADOTS_API_TOKEN=
ALPHADOTS_LOG_LEVEL=INFO

# --- Web UI (server-side only; never exposed to the browser) ----------------
ALPHADOTS_API_URL=http://localhost:18000

# --- Research agent (M4): bounded LangGraph research brief + pipeline monitor ----
#
# Leave ALPHADOTS_GROQ_API_KEY empty and the agent runs on a deterministic, offline
# mock model — no key needed, nothing billed, and every test and `make agent-smoke`
# check passes exactly the same way. Paste a real key from https://console.groq.com/keys
# below and restart (`make agents` or `make dev-agent`) to switch to a live model; no
# code change needed either way. ALPHADOTS_LLM_PROVIDER=mock forces the mock back on
# even with a key set, which is useful while developing against a fixed, free baseline.
ALPHADOTS_LLM_PROVIDER=auto
ALPHADOTS_GROQ_API_KEY=
ALPHADOTS_GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Groq's published rate for ALPHADOTS_GROQ_MODEL, in USD per *million* tokens.
# Rates change and this codebase cannot verify them, so cost is reported as "not
# estimated" until you set both — check https://groq.com/pricing first.
ALPHADOTS_GROQ_PRICE_INPUT_PER_M_USD=
ALPHADOTS_GROQ_PRICE_OUTPUT_PER_M_USD=

# Bounds applied to every agent run, mock or live (see docs/cost-guardrails.md).
ALPHADOTS_AGENT_MAX_TOOL_CALLS=8
ALPHADOTS_AGENT_MAX_TOKENS=900
ALPHADOTS_AGENT_TIMEOUT_SECONDS=25
ALPHADOTS_AGENT_MAX_COST_USD=0.02
ALPHADOTS_MONITOR_CACHE_SECONDS=30

# Where the API reaches research_agent, and where research_agent listens locally.
ALPHADOTS_RESEARCH_AGENT_URL=http://localhost:18100
ALPHADOTS_RESEARCH_AGENT_PORT=18100
