{
  "$defs": {
    "AbstainReason": {
      "enum": [
        "no_lexicon_match",
        "unsupported_language",
        "high_entropy"
      ],
      "title": "AbstainReason",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "earnings",
        "guidance",
        "m_and_a",
        "regulatory",
        "product",
        "management",
        "macro",
        "other"
      ],
      "title": "EventType",
      "type": "string"
    },
    "InstrumentRef": {
      "description": "A resolved link between an event and a tradable instrument.\n\n``instrument_id`` is the stable identifier; ``symbol`` is the ticker that was effective\nat the event's publication time and may be reused by a different issuer later.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "instrument_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "symbol": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "instrument_id",
        "confidence"
      ],
      "title": "InstrumentRef",
      "type": "object"
    },
    "PolarityScores": {
      "description": "A distribution over polarity classes.\n\nOnly a calibrated model may call these probabilities. ``calibration_version`` on the\nparent message says whether that is the case.",
      "properties": {
        "negative": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Negative",
          "type": "number"
        },
        "neutral": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Neutral",
          "type": "number"
        },
        "positive": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Positive",
          "type": "number"
        }
      },
      "required": [
        "negative",
        "neutral",
        "positive"
      ],
      "title": "PolarityScores",
      "type": "object"
    }
  },
  "description": "``sentiment.scored.v1`` \u2014 polarity for one normalised event.\n\nThis is Task A (financial NLP). It is not a return prediction.",
  "properties": {
    "abstain_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/AbstainReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "abstained": {
      "title": "Abstained",
      "type": "boolean"
    },
    "available_at": {
      "description": "Earliest time a consumer could realistically have used this message. Every point-in-time filter compares against this field.",
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "calibration_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Calibration Version",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "entropy": {
      "description": "Shannon entropy of `scores`, normalised by ln 3.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Entropy",
      "type": "number"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "first_seen_at": {
      "description": "When AlphaDots first observed the item.",
      "format": "date-time",
      "title": "First Seen At",
      "type": "string"
    },
    "ingested_at": {
      "description": "When the item was accepted into the pipeline.",
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "instruments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InstrumentRef"
      },
      "title": "Instruments",
      "type": "array"
    },
    "materiality": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Materiality",
      "type": "number"
    },
    "model_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Model Version",
      "type": "string"
    },
    "normalized_event_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Normalized Event Id",
      "type": "string"
    },
    "novelty": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Novelty",
      "type": "number"
    },
    "payload_ref": {
      "description": "URI of the immutable raw payload (fixture://, s3://, ...).",
      "maxLength": 1024,
      "minLength": 1,
      "title": "Payload Ref",
      "type": "string"
    },
    "published_at": {
      "description": "Publication time as claimed by the source.",
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "rationale_terms": {
      "default": [],
      "description": "Terms a transparent model matched; empty for opaque models.",
      "items": {
        "type": "string"
      },
      "title": "Rationale Terms",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "pattern": "^1\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/PolarityScores"
    },
    "signed_sentiment": {
      "description": "positive minus negative",
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Signed Sentiment",
      "type": "number"
    },
    "source": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_event_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Event Id",
      "type": "string"
    },
    "source_license": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source License",
      "type": "string"
    },
    "source_url": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^https?://",
      "title": "Source Url",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "trace_id",
    "available_at",
    "source",
    "source_event_id",
    "content_hash",
    "source_url",
    "published_at",
    "first_seen_at",
    "ingested_at",
    "source_license",
    "payload_ref",
    "normalized_event_id",
    "model_id",
    "model_version",
    "calibration_version",
    "scores",
    "signed_sentiment",
    "entropy",
    "abstained",
    "event_type",
    "materiality",
    "novelty"
  ],
  "title": "SentimentScoredV1",
  "type": "object"
}
