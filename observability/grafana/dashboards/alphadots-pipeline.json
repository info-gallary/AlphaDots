{
  "title": "AlphaDots Pipeline",
  "uid": "alphadots-pipeline",
  "description": "Ingestion, pipeline stages, model behaviour, API and research agent. Run `make demo` for traffic.",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "alphadots"
