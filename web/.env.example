# Dashboard configuration. Copy to `.env.local` for local overrides; on Vercel set these
# under Project Settings -> Environment Variables. Both are read on the server only and
# are never sent to the browser.

# Leave unset to serve the bundled read-model snapshot (src/data/snapshot.json).
# Set it to proxy every request to a running AlphaDots API instead, for example the
# compose stack (`make up`) or a deployed API:
#   ALPHADOTS_API_URL=http://localhost:18000
ALPHADOTS_API_URL=

# Bearer token, only if that API was started with ALPHADOTS_API_TOKEN.
ALPHADOTS_API_TOKEN=
